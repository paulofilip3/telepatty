# systemd unit for the telepatty local server
# Install: sudo cp telepatty.service /etc/systemd/system/
#          sudo systemctl enable --now telepatty

[Unit]
Description=Telepatty tmux web controller
After=network.target

[Service]
Type=simple
User=%u
WorkingDirectory=/path/to/telepatty
Environment=TELEPATTY_TOKEN=changeme
Environment=TELEPATTY_HOST=127.0.0.1
Environment=TELEPATTY_PORT=7857
ExecStart=/usr/local/bin/uvicorn server.main:app --host 127.0.0.1 --port 7857
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
